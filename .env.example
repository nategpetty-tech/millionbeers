EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
EXPO_PUBLIC_SENTRY_DSN=https://your-public-sentry-dsn@sentry.io/project-id
# Local screenshots only. Keep false for release builds.
EXPO_PUBLIC_SCREENSHOT_DEMO=false
# Public Cloudflare Images delivery config. Use either account hash or a custom delivery base URL.
EXPO_PUBLIC_CLOUDFLARE_IMAGES_ACCOUNT_HASH=your-cloudflare-images-account-hash
# EXPO_PUBLIC_CLOUDFLARE_IMAGES_DELIVERY_BASE_URL=https://imagedelivery.net/your-account-hash

# Server-side only: set these as Supabase Edge Function secrets, not in Expo.
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_IMAGES_API_TOKEN=your-cloudflare-images-api-token
# CLOUDFLARE_IMAGES_ACCOUNT_HASH=your-cloudflare-images-account-hash
# FOURSQUARE_API_KEY=your-foursquare-places-api-key
# SENTRY_AUTH_TOKEN=your-sentry-auth-token-for-source-map-upload
